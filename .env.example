# Local environment variables for development.
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your real keys never leave your machine.
#
# In production: set these same variables in Netlify
# (Site settings → Environment variables), NOT in .env.

# Google Cloud API key with Places API (New) enabled.
# Get one at: https://console.cloud.google.com/apis/credentials
# Restrict to HTTP referrer https://pickleballgeneva.netlify.app/* in production.
GOOGLE_PLACES_API_KEY=

# Google Place ID for "Pickleball Geneva Sports Club" (format: ChIJ...).
# Find it via: https://developers.google.com/maps/documentation/places/web-service/place-id
# Search "Pickleball Geneva Sports Club" in the Place ID Finder widget.
GOOGLE_PLACE_ID=
