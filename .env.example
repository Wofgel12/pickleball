# Local environment variables for development.
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your real keys never leave your machine.
#
# In production: set these same variables in Netlify
# (Site settings → Environment variables), NOT in .env.

# Google Cloud API key with Places API (New) enabled.
# Get one at: https://console.cloud.google.com/apis/credentials
# Restrict to HTTP referrer https://pickleballgeneva.netlify.app/* in production.
GOOGLE_PLACES_API_KEY=

# Google Place ID for "Pickleball Geneva Sports Club" (format: ChIJ...).
# Find it via: https://developers.google.com/maps/documentation/places/web-service/place-id
# Search "Pickleball Geneva Sports Club" in the Place ID Finder widget.
GOOGLE_PLACE_ID=

# --- Tournoi : inscriptions + paiement (voir src/lib/tournament-server.ts) ---
# Stripe → Developers → API keys (sk_test_… pour tester, sk_live_… en production)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://gscpickleball.ch/api/tournoi/stripe-webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# Supabase projet « GSC » → Project Settings → API Keys : clé service_role (eyJ…) ou Secret key (sb_secret_…), jamais la clé anon/publishable
SUPABASE_URL=https://ywyrydgzxohshsmudqyq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : e-mail de confirmation personnalisé via Resend (sinon reçu Stripe uniquement)
RESEND_API_KEY=
TOURNAMENT_EMAIL_FROM="GSC Pickleball <tournoi@genevasportsclub.ch>"
# TEST UNIQUEMENT : "true" = pas de Stripe, inscriptions confirmées directement
# (bandeau MODE TEST sur la page). Ignoré automatiquement une fois published: true.
TOURNAMENT_FAKE_PAYMENT=
