## Netlify edge headers ##

# Long-cache static, immutable assets (Astro hashed)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache typical media (1 month, revalidated)
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.mp4
  Cache-Control: public, max-age=2592000

# llms.txt + llms-full.txt — explicit text/plain so AI crawlers parse correctly
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Security headers — applied to every route.
# CSP runs in Report-Only first; promote to enforced once a week of reports
# confirms no breakage from lottie.host or Netlify Image CDN.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://lottie.host; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; media-src 'self' blob:; frame-src https://www.youtube.com https://www.google.com https://lottie.host; connect-src 'self' https://lottie.host https://*.netlify.app; object-src 'none'; base-uri 'self'; form-action 'self' https://*.netlify.app; frame-ancestors 'self'; upgrade-insecure-requests
