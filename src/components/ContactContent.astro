---
import ContactForm from './islands/ContactForm.tsx';
import { facts, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const visibleAddress = fr ? facts.location : facts.locationEn;

// Pre-built Google Maps embed URL pinned to the GBP "Pickleball Geneva Sports Club"
// (place ID 0x478c65a6c4ab4dc7:0x554b55d62ef23749).
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d972.9041837863234!2d6.1314766!3d46.199053!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x478c65a6c4ab4dc7%3A0x554b55d62ef23749!2sPickleball%20Geneva%20Sports%20Club!5e0!3m2!1s' + (fr ? 'fr' : 'en') + '!2sch!4v1773674166278';
---
<div class="grid md:grid-cols-2 gap-12">
  <div>
    <p class="text-lg text-gray-700 mb-6">
      {fr
        ? "Une question sur le pickleball à Genève ? Une suggestion ? Écrivez-nous : nous répondons généralement sous 24h ouvrées."
        : 'A question about pickleball in Geneva? A suggestion? Write to us — we usually answer within 24 working hours.'}
    </p>
    <ContactForm client:visible lang={lang} contactEmail={facts.email} />
  </div>

  <div class="space-y-6">
    <div class="bg-white/95 p-8 rounded-2xl border-2" style="border-color:#002b2b">
      <h2 class="text-xl font-semibold mb-6 text-gray-900">{fr ? 'Geneva Sports Club' : 'Geneva Sports Club'}</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-4">
          <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 mb-1">Email</p>
            <a href={`mailto:${facts.email}`} class="text-teal-600 hover:text-teal-700 transition-colors">{facts.email}</a>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 mb-1">{fr ? 'Téléphone — association' : 'Phone — association'}</p>
            <a href={`tel:${facts.phonePrimary}`} class="text-blue-600 hover:text-blue-700">{facts.phonePrimaryDisplay}</a>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 mb-1">{fr ? 'Téléphone — sessions pickleball' : 'Phone — pickleball sessions'}</p>
            <a href={`tel:${facts.phoneSession}`} class="text-blue-600 hover:text-blue-700">{facts.phoneSessionDisplay}</a>
          </div>
        </li>
        <li class="flex items-start gap-4">
          <div class="w-12 h-12 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-900 mb-1">{fr ? 'Lieu des sessions' : 'Session location'}</p>
            <address class="not-italic text-teal-600">
              <strong class="block text-gray-900">{facts.venueName}</strong>
              {visibleAddress}
            </address>
            <p class="mt-2">
              <a href={facts.gbpMapUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-teal-700 underline hover:text-teal-800">
                {fr ? 'Voir sur Google Maps →' : 'View on Google Maps →'}
              </a>
            </p>
          </div>
        </li>
      </ul>
    </div>

    <!-- How to find us / transit info -->
    <div class="bg-white/95 p-6 rounded-2xl border-2" style="border-color:#002b2b">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">
        {fr ? 'Comment nous trouver' : 'How to find us'}
      </h3>
      <ul class="text-sm text-gray-700 space-y-2 list-disc list-inside">
        {fr ? (
          <>
            <li>À pied : 5 minutes depuis la gare de Cornavin via la passerelle Sous-Terre.</li>
            <li>Bus TPG lignes 2 et 19 — arrêts « Sainte-Clotilde » ou « Jonction » à 5 min à pied.</li>
            <li>Tram TPG ligne 15 — arrêt « Palladium », puis 7 min à pied.</li>
            <li>9 min à pied depuis la place de Plainpalais.</li>
            <li>Vélo : station Vélospot proche du quai Ernest-Ansermet.</li>
            <li>Voiture : parking blanc en zone bleue dans le quartier ; parking payant Plainpalais à 5 min.</li>
            <li>Entrée par l'entrée principale de l'École de Cité-Jonction. Un membre vous accueille à 19h55.</li>
          </>
        ) : (
          <>
            <li>On foot: 5 minutes from Cornavin station via the Sous-Terre footbridge.</li>
            <li>TPG bus lines 2 and 19 — stops "Sainte-Clotilde" or "Jonction", then a 5-min walk.</li>
            <li>TPG tram line 15 — stop "Palladium", then a 7-min walk.</li>
            <li>9-min walk from Plainpalais square.</li>
            <li>Bike: Vélospot station near Quai Ernest-Ansermet.</li>
            <li>Car: free blue-zone parking nearby; paid Plainpalais car park 5 min away.</li>
            <li>Use the main entrance of École de Cité-Jonction. A member greets you at 7:55 pm.</li>
          </>
        )}
      </ul>
    </div>

    <!-- Map embed pinned to the GBP -->
    <div class="bg-white/95 rounded-2xl border-2 overflow-hidden" style="border-color:#002b2b">
      <iframe
        src={mapEmbed}
        width="100%"
        height="280"
        style="border:0;display:block"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={fr ? 'Carte Pickleball Geneva Sports Club — La Jonction, Genève' : 'Pickleball Geneva Sports Club map — La Jonction, Geneva'}
      ></iframe>
    </div>

    <div class="bg-amber-50/90 p-6 rounded-2xl border-2" style="border-color:#002b2b">
      <p class="text-sm text-gray-700 leading-relaxed">
        {fr
          ? 'Note : certaines sessions peuvent être suspendues pendant les vacances scolaires genevoises. Le calendrier exact est publié sur Meetup.'
          : 'Note: some sessions may pause during Geneva school holidays. The exact calendar is published on Meetup.'}
      </p>
    </div>
  </div>
</div>
