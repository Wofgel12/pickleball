---
import { facts, ui, routes, navLabels, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  lastReviewedDisplay: string;
}
const { lang, lastReviewedDisplay } = Astro.props;
const year = new Date().getFullYear();

const sectionLinks = (['participate', 'learn', 'gear', 'faq', 'contact'] as const).map((key) => ({
  href: routes[key][lang],
  label: navLabels[key][lang],
}));
---
<footer
  class="relative z-10 bg-gray-900 text-white py-10 px-4"
  aria-label={ui.ariaFooter[lang]}
  itemscope
  itemtype="https://schema.org/SportsClub"
>
  <div class="max-w-6xl mx-auto grid gap-8 md:grid-cols-3 text-sm">
    <div>
      <p class="font-semibold text-base mb-2" itemprop="name">Geneva Sports Club</p>
      <p class="text-gray-400 leading-relaxed">
        {lang === 'fr'
          ? 'Association multisports basée à Genève — sessions hebdomadaires de pickleball ouvertes à tous les niveaux.'
          : 'Multi-sport association based in Geneva — weekly pickleball sessions open to all levels.'}
      </p>
      <address class="not-italic text-gray-400 mt-3" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
        <span itemprop="streetAddress">La Jonction</span>,
        <span itemprop="postalCode">1205</span>
        <span itemprop="addressLocality">Genève</span>,
        <span itemprop="addressCountry">Suisse</span>
      </address>
    </div>

    <div>
      <p class="font-semibold text-base mb-2">{lang === 'fr' ? 'Pages' : 'Pages'}</p>
      <ul class="space-y-1 text-gray-400">
        {sectionLinks.map((l) => (
          <li><a class="hover:text-teal-400 transition-colors" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-semibold text-base mb-2">{lang === 'fr' ? 'Nous joindre' : 'Get in touch'}</p>
      <ul class="space-y-1 text-gray-400">
        <li>
          <a href={`mailto:${facts.email}`} class="hover:text-teal-400 transition-colors" itemprop="email">{facts.email}</a>
        </li>
        <li>
          <a href={`tel:${facts.phonePrimary}`} class="hover:text-teal-400 transition-colors" itemprop="telephone">{facts.phonePrimaryDisplay}</a>
        </li>
        <li>
          <a href={`tel:${facts.phoneSession}`} class="hover:text-teal-400 transition-colors">{facts.phoneSessionDisplay}</a>
        </li>
        <li>
          <a href={facts.meetupUrl} rel="noopener noreferrer" target="_blank" class="hover:text-teal-400 transition-colors">Meetup</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-gray-700/50 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
    <p>&copy; {year} Geneva Sports Club. {lang === 'fr' ? 'Tous droits réservés.' : 'All rights reserved.'}</p>
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <li>
        <a href={routes.legal[lang]} class="hover:text-teal-400 transition-colors">
          {navLabels.legal[lang]}
        </a>
      </li>
      <li aria-hidden="true" class="text-gray-700">·</li>
      <li>
        <a href={routes.privacy[lang]} class="hover:text-teal-400 transition-colors">
          {navLabels.privacy[lang]}
        </a>
      </li>
    </ul>
    <p>{lastReviewedDisplay}</p>
  </div>
  <meta itemprop="url" content="https://pickleballgeneva.netlify.app/" />
  <meta itemprop="sport" content="Pickleball" />
</footer>
