---
// Google Maps embed, displayed directly (lazy-loaded when it scrolls into view).
// Google may set cookies once the map loads: see the privacy policy, section 3.
interface Props {
  /** Google Maps embed URL (iframe src). */
  src: string;
  /** Accessible title of the map. */
  title: string;
  /** Height / sizing classes. */
  class?: string;
}
const { src, title, class: className = 'h-[300px]' } = Astro.props;
---
<div class:list={['relative w-full bg-teal-50', className]}>
  <iframe
    src={src}
    title={title}
    class="absolute inset-0 w-full h-full border-0"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</div>
