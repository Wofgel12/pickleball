---
import { visibleNews, newsUrl } from '../i18n/news';
import RichText from './RichText.astro';
import NewsArticleBody from './NewsArticleBody.astro';
import { facts, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const items = visibleNews();

const formatDate = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString(fr ? 'fr-CH' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---
{items.length === 0 ? (
  <div class="bg-white/95 rounded-2xl border-2 p-8 md:p-10 text-center" style="border-color:#002b2b">
    <p class="text-xl font-semibold text-gray-900 mb-2">
      {fr ? 'Pas encore d’actualités… mais ça arrive !' : 'No news yet… but it’s coming!'}
    </p>
    <p class="text-gray-700 mb-6">
      {fr
        ? 'En attendant, retrouvez toutes nos sessions et événements sur Meetup.'
        : 'Meanwhile, find all our sessions and events on Meetup.'}
    </p>
    <a
      href={fr ? facts.meetupUrlFr : facts.meetupUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-press inline-block rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3"
    >
      {fr ? 'Voir nos événements sur Meetup' : 'See our events on Meetup'}
    </a>
  </div>
) : (
  <ol class="space-y-8">
    {items.map((item) => (
      <li>
        <article
          id={item.id}
          class="scroll-mt-28 bg-white/95 rounded-2xl border-2 p-7 md:p-10"
          style="border-color:#002b2b"
        >
          <time datetime={item.date} class="text-sm font-semibold uppercase tracking-wider text-teal-700">
            {formatDate(item.date)}
          </time>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-2 mb-4 text-balance">
            <!-- Title: its own page, else where its button leads (e.g. the tournament page) -->
            <a href={item.page || !item.cta ? newsUrl(item, lang) : item.cta.href[lang]} class="hover:text-teal-800">{item.title[lang]}</a>
          </h2>
          {item.page ? (
            <!-- Item with its own page: teaser here, full article there -->
            <>
              <p class="text-lg text-gray-800"><RichText text={item.body[lang][0]} /></p>
              <a
                href={newsUrl(item, lang)}
                class="btn-press mt-6 inline-flex items-center gap-2 rounded-xl bg-[#002b2b] hover:bg-[#003d3d] text-white font-semibold px-5 py-3"
              >
                {item.video
                  ? (fr ? 'Lire l’article et voir la vidéo' : 'Read the article and watch the video')
                  : (fr ? 'Lire l’article' : 'Read the article')} →
              </a>
            </>
          ) : (
            <NewsArticleBody item={item} lang={lang} />
          )}
        </article>
      </li>
    ))}
  </ol>
)}
