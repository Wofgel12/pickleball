---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  /** Short citable subtitle (1-2 sentences, factual). Optional. */
  lead?: string;
}
const { title, lead } = Astro.props;
---
<section class="pt-12 pb-6 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 text-balance">{title}</h1>
    {lead && <p class="text-lg md:text-xl text-gray-700 leading-relaxed">{lead}</p>}
  </div>
</section>
