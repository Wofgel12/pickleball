---
// "Ils parlent de nous": the Geneva Sports Club segment of Léman Bleu's
// "Sport Passion" programme (player in PressVideo.astro).
import PressVideo from './PressVideo.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<section class="relative px-4 pt-16 md:pt-20" aria-labelledby="press-title">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8 md:mb-10">
      <h2 id="press-title" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        {fr ? 'Ils parlent de nous' : 'In the media'}
      </h2>
      <p class="text-lg text-gray-700">
        {fr
          ? 'Le Geneva Sports Club et ses sessions de pickleball dans l’émission « Sport Passion » de Léman Bleu.'
          : 'The Geneva Sports Club and its pickleball sessions on Léman Bleu’s “Sport Passion” programme.'}
      </p>
    </div>

    <PressVideo lang={lang} />
  </div>
</section>
