---
// Thin announcement bar above the navigation: "tournament registration open".
// Rendered inside the fixed <nav> by Navigation.astro (which decides when to
// show it), so both stay pinned together at the top.
import { routes, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<a
  href={routes.tournament[lang]}
  class="group flex h-9 items-center justify-center gap-2 bg-[#002b2b] px-4 text-sm font-semibold text-white hover:bg-[#003d3d] transition-colors"
>
  <span aria-hidden="true">🏆</span>
  <span class="truncate">
    <span class="sm:hidden">{fr ? 'Tournoi de pickleball · 15 nov.' : 'Pickleball tournament · 15 Nov'}</span>
    <span class="hidden sm:inline">{fr ? 'Inscriptions ouvertes : tournoi de pickleball le 15 novembre 2026 à Genève' : 'Registration open: pickleball tournament on 15 November 2026 in Geneva'}</span>
  </span>
  <span class="shrink-0 text-teal-300 underline underline-offset-2 group-hover:text-teal-200">
    {fr ? 'Je m’inscris' : 'Register'}<span aria-hidden="true"> →</span>
  </span>
</a>
