---
import Countdown from './islands/Countdown.tsx';
import TournamentRegistration from './islands/TournamentRegistration.tsx';
import { tournament, tournamentCopy } from '../i18n/tournament';
import { facts, routes, type Lang } from '../i18n/ui';
import fluffyLogo from '../assets/partners/fluffypuffy.webp';
import cornerLogo from '../assets/partners/pickleballcorner.webp';

const partnerLogos: Record<string, { src: ImageMetadata; alt: string }> = {
  fluffypuffy: { src: fluffyLogo, alt: 'Logo FluffyPuffy' },
  pickleballcorner: { src: cornerLogo, alt: 'Logo Pickleball Corner' },
};

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = tournamentCopy[lang];
const fr = lang === 'fr';

// Rendered server-side so crawlers and no-JS visitors still see the countdown.
const initialDays = Math.max(0, Math.ceil((new Date(tournament.startISO).getTime() - Date.now()) / 86_400_000));
const about = t.about.map((p) => p.replace('{members}', tournament.meetupMembers));
---
<!-- ============ HERO ============ -->
<section class="relative px-4 pt-10 pb-14 md:pt-16 md:pb-20">
  <div class="relative max-w-5xl mx-auto overflow-hidden rounded-[2rem] bg-[#002b2b] text-white shadow-2xl">
    <!-- Decorative court lines + balls -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.13] pointer-events-none" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="#5eead4" stroke-width="3">
        <rect x="120" y="60" width="560" height="380" rx="4" />
        <line x1="400" y1="60" x2="400" y2="440" stroke-dasharray="10 8" />
        <line x1="330" y1="60" x2="330" y2="440" />
        <line x1="470" y1="60" x2="470" y2="440" />
        <line x1="120" y1="250" x2="330" y2="250" />
        <line x1="470" y1="250" x2="680" y2="250" />
      </g>
    </svg>
    <div class="absolute -top-16 -right-16 w-32 h-32 md:-top-10 md:-right-10 md:w-60 md:h-60 rounded-full bg-[#d9f99d] opacity-90 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 rounded-full" style="background-image:radial-gradient(circle,#65a30d 0 5%,transparent 6%);background-size:28% 28%;background-position:center;opacity:.35"></div>
    </div>
    <div class="absolute -bottom-12 -left-12 w-32 h-32 md:w-40 md:h-40 rounded-full bg-teal-400/30 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 px-6 py-12 md:px-14 md:py-16 text-center hero-stagger">
      <div>
        <p class="inline-block rounded-full bg-white/10 border border-white/20 px-4 py-1.5 text-sm font-semibold tracking-wide text-teal-100 mb-6">
          🏆 {t.kicker}
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-balance max-w-4xl mx-auto mb-6">
          {t.title}
        </h1>
        <ul class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10 text-base sm:text-lg">
          <li class="flex items-center gap-2 rounded-full bg-white text-[#002b2b] font-semibold px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <time datetime={tournament.startISO}>{t.dateLong}</time>
          </li>
          <li class="flex items-center gap-2 rounded-full bg-white/10 border border-white/25 px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {t.hours}
          </li>
          <li>
            <a href={tournament.mapsUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-full bg-white/10 border border-white/25 px-4 py-2 hover:bg-white/20 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{tournament.venueName}, {fr ? 'Genève' : 'Geneva'}</span>
              <span class="underline underline-offset-2 text-teal-200 text-sm">Maps ↗</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="mb-10">
        <Countdown
          client:load
          lang={lang}
          startISO={tournament.startISO}
          endISO={tournament.endISO}
          initialDays={initialDays}
        />
      </div>

      <div>
        <a href="#inscription" class="btn-press inline-flex items-center gap-2 rounded-2xl bg-teal-400 hover:bg-teal-300 text-[#002b2b] text-lg font-bold px-8 py-4 shadow-lg">
          {t.ctaRegister}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="mt-3 text-sm text-white/70">
          {fr ? 'Places limitées dans chaque tableau · premier arrivé, premier servi' : 'Limited places in every draw · first come, first served'}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="px-4 pb-16">
  <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-8 items-start">
    <div class="md:col-span-3 bg-white/95 rounded-2xl border-2 border-[#002b2b] p-7 md:p-10">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-5 text-balance">{t.aboutTitle}</h2>
      {about.map((p, i) => (
        <p class:list={['text-gray-800 text-lg mb-4 last:mb-0', i === about.length - 1 && 'font-semibold text-teal-800']}>{p}</p>
      ))}
    </div>
    <ul class="md:col-span-2 grid gap-4">
      {t.highlights.map((h, i) => (
        <li class="flex gap-4 items-start bg-white/95 rounded-2xl border-2 border-[#002b2b] p-5">
          <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-teal-50 text-2xl flex items-center justify-center" aria-hidden="true">
            {['🎾', '🎁', '☀️'][i]}
          </span>
          <div>
            <p class="font-bold text-gray-900 text-lg">{h.title}</p>
            <p class="text-gray-700">{h.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- ============ PARTNERS ============ -->
<section class="px-4 pb-20">
  <div class="max-w-5xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">{t.partnersTitle}</h2>
      <p class="text-lg text-gray-700">{t.partnersLead}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {tournament.partners.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="card-lift group flex flex-col bg-white/95 rounded-2xl border-2 border-[#002b2b] p-7 hover:shadow-lg"
        >
          <div class="h-28 mb-6 rounded-xl bg-white flex items-center justify-center px-4">
            <!-- Plain <img>: logos are already small, pre-sized webp files, so they
                 don't depend on Netlify's image CDN (works in local previews too). -->
            <img
              src={partnerLogos[p.id].src.src}
              width={partnerLogos[p.id].src.width}
              height={partnerLogos[p.id].src.height}
              alt={partnerLogos[p.id].alt}
              class="max-h-24 w-auto max-w-full object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-teal-700 mb-1">{p.role[lang]}</p>
            <p class="text-2xl font-bold text-gray-900 mb-2">{p.name}</p>
            <p class="text-gray-700 mb-3">{p.text[lang]}</p>
            <span class="font-semibold text-teal-700 group-hover:text-teal-900 transition-colors">
              {p.url.replace(/^https?:\/\//, '').replace(/\/.*$/, '')} ↗
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ PRACTICAL INFO ============ -->
<section class="px-4 pb-20">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8 items-stretch">
    <div class="bg-white/95 rounded-2xl border-2 border-[#002b2b] p-7 md:p-9">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">{t.infoTitle}</h2>
      <dl class="grid grid-cols-[auto,1fr] gap-x-6 gap-y-3">
        {t.info.map((row) => (
          <>
            <dt class="font-semibold text-teal-700">{row.dt}</dt>
            <dd class="text-gray-800">{row.dd}</dd>
          </>
        ))}
      </dl>
    </div>
    <div class="flex flex-col overflow-hidden rounded-2xl border-2 border-[#002b2b] bg-white/95">
      <iframe
        src={tournament.mapsEmbedUrl + (fr ? 'fr' : 'en')}
        title={fr ? `Carte : ${tournament.venueName}, Genève` : `Map: ${tournament.venueName}, Geneva`}
        class="w-full flex-1 min-h-[300px] border-0 block"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t-2 border-[#002b2b]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">{fr ? 'Lieu' : 'Venue'}</p>
          <p class="text-xl font-bold text-gray-900">{tournament.venueName}</p>
        </div>
        <a
          href={tournament.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-press rounded-xl bg-[#002b2b] text-white font-semibold px-4 py-2.5 hover:bg-[#003d3d]"
        >
          {t.ctaMap} ↗
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============ DRAWS + REGISTRATION ============ -->
<section id="inscription" class="px-4 pb-20 scroll-mt-20">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">{t.categoriesTitle}</h2>
      <p class="text-lg text-gray-700">{t.categoriesLead}</p>
    </div>
    <!-- client:load (not :visible): after Stripe redirects back, the success
         banner must render and scroll into view immediately. -->
    <TournamentRegistration client:load lang={lang} contactEmail={facts.email} />
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section class="px-4 pb-20">
  <div class="max-w-3xl mx-auto text-center bg-white/95 rounded-2xl border-2 border-[#002b2b] p-8 md:p-10">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{t.contactTitle}</h2>
    <p class="text-gray-700 mb-5">{t.contactText}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={`mailto:${facts.email}`} class="btn-press rounded-xl bg-[#002b2b] text-white font-semibold px-5 py-3">{facts.email}</a>
      <a href={`tel:${facts.phoneSession}`} class="btn-press rounded-xl border-2 border-[#002b2b] text-[#002b2b] font-semibold px-5 py-3">{facts.phoneSessionDisplay}</a>
    </div>
    <p class="mt-6">
      <a href={routes.home[lang]} class="text-teal-700 underline hover:text-teal-900">{t.backToSite} →</a>
    </p>
  </div>
</section>
