---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactContent from '../../components/ContactContent.astro';
import { facts } from '../../i18n/ui';

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://gscpickleball.ch';

// addressLocality uses the official Swiss postal name "Genève" (not "Geneva")
// so every schema block on the site resolves to the same Google entity.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': SITE + '/en/contact/#localbusiness',
  name: 'Geneva Sports Club — Pickleball',
  url: SITE + '/en/contact/',
  email: facts.email,
  telephone: facts.phonePrimary,
  image: SITE + '/og-pickleball-geneve.jpg',
  priceRange: 'CHF 10',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'École de Cité-Jonction, La Jonction',
    addressLocality: 'Genève',
    postalCode: '1205',
    addressRegion: 'GE',
    addressCountry: 'CH',
  },
  geo: { '@type': 'GeoCoordinates', latitude: facts.geo.lat, longitude: facts.geo.lon },
  hasMap: facts.gbpMapUrl,
  sameAs: [{ '@id': SITE + '/#sportsclub' }],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '20:00', closes: '22:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '20:00', closes: '22:00' },
  ],
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer support', email: facts.email, telephone: facts.phonePrimary, availableLanguage: ['fr', 'en'] },
    { '@type': 'ContactPoint', contactType: 'sessions',         telephone: facts.phoneSession, availableLanguage: ['fr', 'en'] },
  ],
};
---
<BaseLayout pageKey="contact" lang="en" jsonLd={[localBusiness]}>
  <div class="bg-tile">
    <PageHero
      lang="en"
      title="Contact — Geneva Sports Club Pickleball"
    />
    <section class="py-12 px-4">
      <div class="max-w-6xl mx-auto">
        <ContactContent lang="en" />
      </div>
    </section>
  </div>
</BaseLayout>
