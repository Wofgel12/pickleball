---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LearnContent from '../../components/LearnContent.astro';
import { facts } from '../../i18n/ui';

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pickleballgeneva.netlify.app';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Learn pickleball: rules, glossary and technique',
  description: 'Complete English guide to pickleball in Geneva: court, serve, scoring, technical glossary (kitchen, dink, drive), minimum gear, and beginner mistakes to avoid.',
  inLanguage: 'en-GB',
  author: { '@type': 'Organization', name: 'Geneva Sports Club', url: SITE + '/' },
  publisher: {
    '@type': 'Organization',
    name: 'Geneva Sports Club',
    logo: { '@type': 'ImageObject', url: SITE + '/logo-img.png' },
  },
  datePublished: '2026-01-15',
  dateModified: facts.lastReviewedISO,
  mainEntityOfPage: SITE + '/en/learn/',
  image: SITE + '/og-pickleball-geneve.jpg',
};
---
<BaseLayout pageKey="learn" lang="en" jsonLd={[articleSchema]}>
  <div class="bg-tile">
    <PageHero
      lang="en"
      title="Learn pickleball in Geneva"
      lead="Everything you need to understand and play pickleball: official rules, court dimensions, technical glossary, scoring, minimum gear, and beginner mistakes to avoid."
    />
    <section class="py-12 px-4">
      <div class="max-w-6xl mx-auto">
        <LearnContent lang="en" />
      </div>
    </section>
  </div>
</BaseLayout>
