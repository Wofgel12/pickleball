---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PrivacyContent from '../../components/PrivacyContent.astro';
---
<BaseLayout pageKey="privacy" lang="en" noindex>
  <div class="bg-tile">
    <PageHero
      lang="en"
      title="Privacy Policy"
      lead="How the Geneva Sports Club handles your personal data on gscpickleball.ch: site visits, contact form and tournament registrations."
    />
    <section class="py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <article
          class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-sm border-2 p-8 md:p-12 text-gray-800 leading-relaxed prose-legal"
          style="border-color: #002b2b;"
        >
          <PrivacyContent lang="en" />
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
