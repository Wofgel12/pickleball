---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaddleDoodles from '../../components/PaddleDoodles.astro';
import TournamentContent from '../../components/TournamentContent.astro';
import { tournament } from '../../i18n/tournament';
import { tournamentSchema } from '../../lib/tournament-schema';

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://gscpickleball.ch';
---
<BaseLayout pageKey="tournament" lang="en" jsonLd={[tournamentSchema(SITE, 'en')]} noindex={!tournament.published} lastReviewedISO={tournament.updatedISO} ogImage="/og-tournoi-en.jpg" ogImageAlt="Geneva Sports Club pickleball tournament, Sunday 15 November 2026, 9am–6pm, Collège Calvin, Geneva">
  <div class="bg-tile relative isolate">
    <PaddleDoodles />
    <TournamentContent lang="en" />
  </div>
</BaseLayout>
