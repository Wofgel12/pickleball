---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqContent from '../components/FaqContent.astro';
import { faqFR, faqJsonLd } from '../i18n/faq';
---
<BaseLayout pageKey="faq" lang="fr" jsonLd={[faqJsonLd(faqFR)]}>
  <div class="bg-tile">
    <PageHero
      lang="fr"
      title="FAQ pickleball à Genève"
      lead="Réponses aux 16 questions les plus posées sur le pickleball à Genève."
    />
    <section class="py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <FaqContent lang="fr" />
      </div>
    </section>
  </div>
</BaseLayout>
