---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ParticipateContent from '../components/ParticipateContent.astro';
import { facts } from '../i18n/ui';

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pickleballgeneva.netlify.app';

// Service schema replaces deprecated HowTo (Google removed HowTo rich results 2023-09).
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': SITE + '/participer/#service',
  name: 'Sessions de pickleball à Genève — Geneva Sports Club',
  description: "Sessions hebdomadaires de pickleball ouvertes à tous les niveaux à La Jonction (Genève). Inscription via Meetup, 10 CHF par session, raquettes et balles fournies.",
  serviceType: 'Pickleball sessions',
  provider: { '@id': SITE + '/#sportsclub' },
  areaServed: [
    { '@type': 'City', name: 'Genève' },
    { '@type': 'AdministrativeArea', name: 'Canton of Geneva' },
  ],
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: facts.meetupUrl,
    serviceLocation: {
      '@type': 'Place',
      name: facts.venueName,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'École de Cité-Jonction, La Jonction',
        addressLocality: 'Genève',
        postalCode: '1205',
        addressRegion: 'GE',
        addressCountry: 'CH',
      },
    },
  },
  offers: {
    '@type': 'Offer',
    price: facts.priceCHF,
    priceCurrency: 'CHF',
    availability: 'https://schema.org/InStock',
    url: facts.meetupUrl,
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'All levels — beginners welcome',
  },
  hoursAvailable: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '18:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '18:00', closes: '20:00' },
  ],
};
---
<BaseLayout pageKey="participate" lang="fr" jsonLd={[service]}>
  <div class="bg-tile">
    <PageHero
      lang="fr"
      title="Participer à une session de pickleball à Genève"
    />
    <section class="py-12 px-4">
      <div class="max-w-6xl mx-auto">
        <ParticipateContent lang="fr" />
      </div>
    </section>
  </div>
</BaseLayout>
