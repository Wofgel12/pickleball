---
import BaseLayout from '../layouts/BaseLayout.astro';
import TournamentContent from '../components/TournamentContent.astro';
import { tournament } from '../i18n/tournament';
import { tournamentSchema } from '../lib/tournament-schema';

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://gscpickleball.ch';
---
<BaseLayout pageKey="tournament" lang="fr" jsonLd={[tournamentSchema(SITE, 'fr')]} noindex={!tournament.published}>
  <div class="bg-tile">
    <TournamentContent lang="fr" />
  </div>
</BaseLayout>
