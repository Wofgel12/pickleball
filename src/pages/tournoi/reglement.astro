---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TournamentRulesContent from '../../components/TournamentRulesContent.astro';
import { tournament } from '../../i18n/tournament';
---
<BaseLayout pageKey="tournamentRules" lang="fr" noindex={!tournament.published}>
  <div class="bg-tile">
    <PageHero lang="fr" title="Règlement du tournoi" lead="Tournoi de pickleball du Geneva Sports Club — dimanche 15 novembre 2026, Collège Calvin, Genève." />
    <section class="py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <article
          class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-sm border-2 p-8 md:p-12 text-gray-800 leading-relaxed"
          style="border-color: #002b2b;"
        >
          <TournamentRulesContent lang="fr" />
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
